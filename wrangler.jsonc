{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextgenergy-ai",
  "compatibility_date": "2026-08-04",
  "routes": [
    {
      "pattern": "nextgenergy.ai",
      "custom_domain": true
    },
    {
      "pattern": "www.nextgenergy.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "."
  }
}
