---
import '@/styles/fonts.css';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import type { LdNode } from '@/lib/ld';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  /** Extra JSON-LD nodes (DefinedTerm, FAQPage, Article, Person, SoftwareApplication…) merged into the page's @graph. */
  ld?: LdNode[];
  /** Path of a Markdown twin of this page, exposed via <link rel="alternate" type="text/markdown">. */
  mdAlternate?: string;
}
const { title, description = site.description, canonical, type = 'website', published, modified, ld = [], mdAlternate } = Astro.props;
const fullTitle = title === site.name ? `${site.name} | ${site.headline}` : `${title} | ${site.name} – ${site.tagline}`;
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const url = new URL(cleanPath, Astro.site);
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${Astro.site}#org`, name: site.name, legalName: site.legalName, url: String(Astro.site), logo: new URL('/brand/emblem-512.png', Astro.site).href, description: site.headline, foundingDate: site.foundingDate, address: { '@type': 'PostalAddress', addressLocality: 'Toronto', addressRegion: 'ON', addressCountry: 'CA' }, email: site.email, founder: { '@type': 'Person', name: 'Jim Li', jobTitle: 'Founder & CEO', sameAs: ['https://www.linkedin.com/in/junming-li-liquid-cooling/'] }, sameAs: [site.linkedin, site.substack, 'https://tsingchain.ai'], knowsAbout: ['liquid cooling', 'direct-to-chip cooling', 'coolant distribution unit', 'data centre heat reuse', 'return-water grade', 'commissioning'] },
    { '@type': 'WebSite', '@id': `${Astro.site}#website`, url: String(Astro.site), name: site.name, publisher: { '@id': `${Astro.site}#org` }, inLanguage: 'en' },
    { '@type': 'WebPage', '@id': url.href, url: url.href, name: fullTitle, description, isPartOf: { '@id': `${Astro.site}#website` }, inLanguage: 'en', ...(published ? { datePublished: published.toISOString() } : {}), ...(modified || published ? { dateModified: (modified ?? published)!.toISOString() } : {}) },
    ...ld,
  ],
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical ?? url.href} />
    <!-- Google Analytics 4 with Consent Mode: analytics storage denied until the visitor accepts (see /google-analytics.js and /company/privacy) -->
    <link rel="stylesheet" href="/google-analytics.css" />
    <script is:inline src="/google-analytics.js"></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SQ8WX1BMRW"></script>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/emblem-512.png" />
    <meta property="og:image" content="/brand/emblem-512.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} Insights`} href="/insights/rss.xml" />
    {mdAlternate && <link rel="alternate" type="text/markdown" title="Markdown version" href={mdAlternate} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url.href} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={jsonld} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <Header />
    <noscript><div class="noscript wrap">This site works without JavaScript except for the interactive tools, the video player and the mobile menu. Navigation links are in the footer.</div></noscript>
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
