---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '@/data/site';
import { claims } from '@/data/claims';
const latest = (await getCollection('insights', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const stats = [
  { c: claims['founding-8-years'], label: 'of liquid-cooling focus in our founding team, immersion and direct-to-chip' },
  { c: claims['deployed-1000mw'], label: 'of liquid cooling delivered by our founding team' },
];
const chain = ['Plan', 'Design', 'Prefabricate', 'Commission', 'Operate', 'Reuse heat'];
import CallLink from '@/components/CallLink.astro';
---
<Base title={site.name} eventBar>
  <section class="hero home-hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">Liquid cooling for AI data centres · Toronto</div>
          <h1>Prefabricated liquid cooling and heat reuse for AI data centres.</h1>
          <p class="lede">We plan and design the liquid-cooled compute hall and deliver it as factory-built skids, CDUs, ORv3 racks and cooling plant. Across North America we also test, commission and maintain the liquid loop on site. Every boundary is handed over with its evidence.</p>
          <div class="btn-row">
            <a class="btn primary" href="/platform">Products and systems</a>
            <a class="btn" href="/services/field">Field testing and operations</a>
          </div>
        </div>
        <figure class="hero-fig">
          <picture><source type="image/webp" srcset="/products/hero-skid-700.webp 700w, /products/hero-skid-1400.webp 1400w" sizes="(min-width: 900px) 520px, calc(100vw - 5rem)" /><img src="/products/hero-skid.jpg" alt="Prefabricated liquid-cooling skid: a row of liquid-cooled racks on a steel frame with overhead supply and return headers, cable trays and an integrated CDU" width="1400" height="933" fetchpriority="high" decoding="async" /></picture>
          <figcaption>Illustrative prefabricated configuration. Equipment and performance are confirmed per project.</figcaption>
        </figure>
      </div>
      <div class="chain" aria-label="What we do, in order">
        {chain.map((s, i) => <span class="step"><span>{s}</span>{i < chain.length - 1 && <span class="arrow" aria-hidden="true">›</span>}</span>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="eyebrow">What we do</div>
      <h2>Two things, and the records for both.</h2>
      <div class="lines">
        <a class="card media line" href="/platform">
          <div class="card-img render"><picture><source type="image/webp" srcset="/products/cdu-family.webp" /><img src="/products/cdu-family.jpg" alt="Three coolant distribution units: in-rack, liquid-to-air and in-row" loading="lazy" width="1200" height="800" /></picture></div>
          <div class="card-body">
            <span class="num">01</span>
            <h3>Prefabricated liquid cooling systems</h3>
            <p>We plan and design liquid-cooled AI data centres and deliver the cooling system as a coordinated package of four product families, with interfaces and acceptance criteria agreed before manufacture.</p>
            <ul class="chips">
              <li>Prefabricated skids</li><li>ORv3 and 19-inch racks</li><li>CDUs</li><li>Cooling equipment</li>
            </ul>
            <span class="more">Four product families →</span>
          </div>
        </a>
        <a class="card media line" href="/services/field">
          <div class="card-img"><picture><source type="image/webp" srcset="/products/field-tech.webp" /><img src="/products/field-tech.jpg" alt="Technician with a tablet checking pressure gauges on liquid-cooling pipework" loading="lazy" width="621" height="658" /></picture></div>
          <div class="card-body">
            <span class="num">02</span>
            <h3>Field testing, verification and operations</h3>
            <p>For liquid-cooled halls across North America, on systems we supplied and on systems we did not: four commissioning gates with written criteria, then a three-tier operations programme for the cooling loop, not the servers.</p>
            <ul class="chips">
              <li>Four gates</li><li>Turnover package</li><li>Tiers 1–3</li><li>L0–L3 service levels</li>
            </ul>
            <span class="more">Field services in North America →</span>
          </div>
        </a>
      </div>
      <div class="stats" id="figures">
        {stats.map((s) => (
          <div class="stat">
            <span class="v">{s.c.value}</span>
            <span class="l">{s.label}</span>
            <span class="cond"><b>Condition:</b> {s.c.condition}</span>
          </div>
        ))}
        <div class="stat">
          <span class="v">Toronto</span>
          <span class="l">sourcing, integration and field coordination for North America</span>
          <span class="cond">NextGenergy, Toronto, Ontario. Manufacturing by qualified partners; site work by licensed and insured partner companies.</span>
        </div>
      </div>
      <p class="small" style="margin-top:1rem"><a href="/company/track-record">The projects behind these figures →</a></p>
    </div>
  </section>

  <section class="section ink sim">
    <div class="wrap">
      <div class="split">
        <div>
          <div class="eyebrow">Plan the system before building it</div>
          <h2>Simulate the whole thermal path, boundary by boundary.</h2>
          <p class="lede">Selection, planning and design are informed by the whole loop: rack load, coolant temperatures, CDU approach, heat rejection and the heat you could reuse. Our concept simulator lets you pick a rack platform, a climate and a pipework layout, then watch junction temperature, flow, pressure drop and pPUE settle, and stress the design with load steps, pump loss or fouling.</p>
          <div class="btn-row">
            <a class="btn ghost" href="https://sim.nextgenergy.ai">Open the simulator</a>
            <a class="btn ghost" href="/tools">All engineering tools</a>
          </div>
          <p class="small dim" style="margin-top:1.2rem">Concept model for planning and comparison. Not for equipment selection, acceptance or performance claims.</p>
        </div>
        <a class="laptop" href="https://sim.nextgenergy.ai" aria-label="Open the liquid cooling simulator">
          <span class="screen"><picture><source type="image/webp" srcset="/products/simulator.webp" /><img src="/products/simulator.jpg" alt="Liquid cooling simulator on a laptop: racks, CDU, dry cooler and trim chiller with live temperatures, flows and pPUE" width="1440" height="900" loading="lazy" /></picture></span>
          <span class="base" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="eyebrow">Go deeper</div>
      <h2>The thinking and the records behind the products.</h2>
      <div class="deeper">
        <a class="card pad-s deep" href="/solutions"><span class="card-title">Solutions</span><span class="d">New build, retrofit, heat reuse, cold climate and edge, each with what to decide early.</span><span class="more">By project type →</span></a>
        <a class="card pad-s deep" href="/approach"><span class="card-title">Our approach</span><span class="d">The thermal path, return-water grade and the three clocks of leak risk.</span><span class="more">How we think →</span></a>
        <a class="card pad-s deep" href="/evidence"><span class="card-title">Evidence</span><span class="d">Commissioning criteria, the turnover package and the ten leak points.</span><span class="more">What we hand over →</span></a>
        <a class="card pad-s deep" href="/insights"><span class="card-title">Insights</span><span class="d">{latest ? latest.data.title : 'Long-form writing on power, liquid cooling and heat reuse.'}</span><span class="more">Latest article →</span></a>
      </div>
    </div>
  </section>

  <section class="section ink cta">
    <div class="wrap center">
      <h2>Bring us your project.</h2>
      <p class="lede">A new build, a retrofit, a heat-reuse scheme, a hall that needs commissioning, or a turnover package you would like verified. Start with your system diagram, equipment list and existing records.</p>
      <div class="btn-row" style="justify-content:center;align-items:center"><a class="btn ghost" href="/company/contact">Talk to our team</a><CallLink onDark /></div>
    </div>
  </section>
</Base>
<style>
  .deeper { display: grid; gap: var(--sp-5); grid-template-columns: 1fr; margin-top: var(--sp-6); }
  @media (min-width: 640px) { .deeper { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .deeper { grid-template-columns: repeat(4, 1fr); } }
  .deep .d { color: var(--ink-2); }
  .home-hero { padding-bottom: clamp(2rem, 4vw, 3rem); }
  .hero.home-hero h1 { max-width: none; }
  .hero-grid { display: grid; gap: 2.5rem; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 6fr); gap: 3.5rem; } }
  .hero-fig { margin: 0; }
  .hero-fig img { width: 100%; height: auto; mix-blend-mode: multiply; }
  @media (min-width: 900px) { .hero-fig { margin-right: -1rem; } }
  .hero-fig figcaption { font-size: var(--fs-xs); color: var(--ink-3); margin-top: 0.4rem; text-align: center; }
  .chain { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; margin-top: clamp(1.8rem, 3vw, 2.6rem); padding-top: 1.2rem; border-top: 1px solid var(--line); font-family: var(--mono); font-size: var(--fs-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); }
  .chain { gap: 0.6rem 0; border-top: 0; padding-top: 0; }
  .chain .step { display: inline-flex; gap: 0; align-items: center; }
  .chain .step::before { content: ""; flex: none; width: 9px; height: 9px; margin-right: 0.55rem; border: 1.5px solid var(--ink); border-radius: var(--r-pill); background: var(--white); }
  .chain .step:last-child::before { background: var(--heat); border-color: var(--heat-text); }
  .chain .arrow { flex: none; width: clamp(0.9rem, 3vw, 2.6rem); height: 1.5px; margin: 0 0.6rem; background: var(--line-strong); color: transparent; line-height: 0; overflow: hidden; }

  .lines { display: grid; gap: var(--sp-5); grid-template-columns: 1fr; margin-top: var(--sp-6); }
  @media (min-width: 820px) { .lines { grid-template-columns: 1fr 1fr; } }
  .chips { list-style: none; padding: 0; margin: auto 0 0; padding-top: 0.6rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chips li { font-size: var(--fs-xs); font-weight: 600; padding: 0.3rem 0.6rem; border-radius: var(--r-pill); background: var(--paper-2); color: var(--ink); }
  .line .more { margin-top: 0; }

  .stats { display: grid; gap: 1.5rem 2.5rem; grid-template-columns: 1fr; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  @media (min-width: 720px) { .stats { grid-template-columns: repeat(3, 1fr); } }
  .stat .v { display: block; font-family: var(--font-figure); font-size: var(--fs-lg); line-height: 1; font-weight: var(--fw-figure); color: var(--ink); margin-bottom: 0.4rem; }
  .stat .l { display: block; color: var(--ink-2); font-size: var(--fs-sm); }
  .stat .cond { display: block; font-size: var(--fs-xs); line-height: 1.45; color: var(--ink-3); margin-top: 0.45rem; max-width: var(--measure-wide); }
  .stat .cond b { color: var(--ink-2); font-weight: 600; }

  .laptop { display: block; width: 100%; max-width: 680px; margin: 0 auto; padding: 0 5%; align-self: center; }
  .laptop .screen { display: block; background: var(--device-screen); border: 1px solid var(--device-edge); border-bottom: 0; border-radius: 16px 16px 0 0; padding: 14px 14px 16px; box-shadow: var(--shadow-2); }
  .laptop .screen img { display: block; width: 100%; height: auto; border-radius: 6px; }
  .laptop .base { display: block; position: relative; height: 16px; margin: 0 -5%; background: var(--device-base); border-radius: 3px 3px 14px 14px; }
  .laptop .base::before { content: ""; position: absolute; left: 50%; top: 0; transform: translateX(-50%); width: 16%; height: 6px; background: var(--device-notch); border-radius: 0 0 8px 8px; }
  .laptop:hover .screen { border-color: var(--device-edge-hover); }
  @media (min-width: 900px) { .sim .split { align-items: center; } }
  .sim .lede { font-size: var(--fs-base); line-height: var(--lh-loose); }
</style>
