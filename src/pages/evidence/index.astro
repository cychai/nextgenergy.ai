---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Card from '@/components/Card.astro';
---
<Base title="Evidence" description="What NextGenergy hands over: commissioning criteria, the turnover package, our standards work, and the ten leak points.">
  <PageHero eyebrow="Evidence" title="Not what we sell. What we can prove." lede="Every vendor has a products page. This is the page a technical buyer should compare instead: the acceptance criteria we commission against, the records we hand over, and the standards work we do in the open." />
  <section class="section">
    <div class="wrap">
      <div class="grid c2">
        <Card href="/evidence/commissioning" num="Criteria" title="Commissioning and acceptance criteria">What "passed" means for each boundary: pressure, cleanliness, approach, flow balance, isolation sequence. Written before the work, not after.</Card>
        <Card href="/evidence/turnover" num="Records" title="The turnover package">Ten boundaries, three questions each: was it tested, against what, and where is the record. The binder is structured so an operator, an insurer or an auditor can answer them without us in the room.</Card>
        <Card href="/evidence/leak-points" num="Reference" title="Ten leak points">Following the coolant from chip to facility. Not a ranking. A checklist that every liquid-cooling team should be able to score their last project against.</Card>
        <Card href="/evidence/standards" num="Community" title="Standards work">Where we contribute language, review drafts and argue about boundaries in public, so that the criteria above are not just ours.</Card>
      </div>
    </div>
  </section>
</Base>
