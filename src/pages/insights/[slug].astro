---
import Base from '@/layouts/Base.astro';
import Related from '@/components/Related.astro';
import { getCollection, render } from 'astro:content';
import { site } from '@/data/site';
import { articleLd } from '@/lib/ld';
export async function getStaticPaths() {
  const posts = (await getCollection('insights', (p) => !p.data.draft)).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  // Previous = the article dated just before this one, next = the one just after.
  return posts.map((p, i) => ({ params: { slug: p.id }, props: { p, prev: posts[i - 1], next: posts[i + 1] } }));
}
const { p, prev, next } = Astro.props;
const { Content, headings } = await render(p);
// Contents list: h2 and h3 of the article, shown only on long pieces (three or more h2).
// A "heading" longer than 80 characters is a paragraph marked up as one in the source (author lines); it is left out.
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.text.length <= 80);
const showToc = toc.filter((h) => h.depth === 2).length >= 3;
const fmt = (d: Date) => d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const defaults: Record<string, { href: string; label: string; kind: 'evidence' | 'tool' | 'approach' | 'insight' }> = {
  '/evidence/leak-points': { href: '/evidence/leak-points', label: 'Ten leak points', kind: 'evidence' },
  '/evidence/turnover': { href: '/evidence/turnover', label: 'The turnover package', kind: 'evidence' },
  '/evidence/commissioning': { href: '/evidence/commissioning', label: 'Commissioning and acceptance criteria', kind: 'evidence' },
  '/tools/return-water': { href: '/tools/return-water', label: 'Return-water grade → heat buyers', kind: 'tool' },
  '/tools/approach-temp': { href: '/tools/approach-temp', label: 'CDU approach and free-cooling estimator', kind: 'tool' },
  '/tools/leak-checklist': { href: '/tools/leak-checklist', label: 'Turnover self-check', kind: 'tool' },
  '/approach/thermal-path': { href: '/approach/thermal-path', label: 'The thermal path', kind: 'approach' },
  '/approach/return-water': { href: '/approach/return-water', label: 'Return-water grade', kind: 'approach' },
  '/approach/three-clocks': { href: '/approach/three-clocks', label: 'Three clocks', kind: 'approach' },
};
const related = p.data.related.map((r) => defaults[r]).filter(Boolean);
const path = `/insights/${p.id}`;
const ld = [articleLd(path, { headline: p.data.title, description: p.data.subtitle, published: p.data.date, modified: p.data.updated, tags: p.data.tags })];
---
<Base ld={ld} mdAlternate={`${path}.md`} title={p.data.title} description={p.data.subtitle ?? site.description} type="article" published={p.data.date} modified={p.data.updated}>
  <div class="progress" data-progress data-v2 aria-hidden="true"></div>
  <article>
    <header class="hero">
      <div class="narrow">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span><a href="/insights">Insights</a></span></nav>
        <div class="eyebrow">Every Watt Counts · <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time>{p.data.updated && <> · Updated <time datetime={p.data.updated.toISOString().slice(0, 10)}>{fmt(p.data.updated)}</time></>}</div>
        <h1>{p.data.title}</h1>
        {p.data.subtitle && <p class="lede">{p.data.subtitle}</p>}
        {p.data.historyNote && <p class="history-note">The projects described here were delivered by our founding team before NextGenergy was founded in 2025.</p>}
        {p.data.tags.length > 0 && <div class="tags" style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-top:1rem">{p.data.tags.map((t) => <a class="tag-pill" href={`/insights/tag/${t}`}>{t}</a>)}</div>}
      </div>
    </header>
    <div class="narrow prose article-body">
      {showToc && (
        <aside class="toc-rail" data-v2>
          <details class="toc" data-toc>
            <summary>Contents</summary>
            <nav aria-label="Contents" data-spy><ol>{toc.map((h) => <li class={h.depth === 3 ? 'd3' : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
          </details>
        </aside>
      )}
      <Content />
      <hr />
      <p class="small muted">By Jim Li, founder of NextGenergy. {p.data.sourceUrl && <>First published on <a href={p.data.sourceUrl}>Substack</a>.</>} Discuss it there or on <a href={site.linkedin}>LinkedIn</a>. <a href={`${path}.md`}>Markdown version</a>.</p>
      <Related items={related} />
      {(prev || next) && (
        <nav class="pn" aria-label="More articles" data-v2>
          {prev && <a class="prev" href={`/insights/${prev.id}`}><span class="k">← Previous</span><span class="t">{prev.data.title}</span></a>}
          {next && <a class="next" href={`/insights/${next.id}`}><span class="k">Next →</span><span class="t">{next.data.title}</span></a>}
        </nav>
      )}
    </div>
  </article>
</Base>
<style>
  .history-note { margin: 1rem 0 0; padding: 0.6rem 0.9rem; border-left: 3px solid var(--heat); background: var(--white); color: var(--ink-2); font-size: var(--fs-sm); max-width: 60ch; }
  .article-body { padding-bottom: 3rem; line-height: var(--lh-article); }
  .article-body :global(h2) { font-size: var(--fs-lg); }
  .article-body :global(h3) { font-size: var(--fs-md); }
  .article-body :global(p > em:only-child) { display: block; font-size: var(--fs-sm); color: var(--ink-3); margin-top: -0.8em; }
</style>
