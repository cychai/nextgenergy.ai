---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/data/site';
import { people } from '@/data/team';
import { personLd } from '@/lib/ld';
const slug = (n: string) => n.toLowerCase().replace(/\(([^)]+)\)/g, '$1').replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
const ld = people.map((p) => personLd({ id: slug(p.name), name: p.name, jobTitle: p.role, description: p.bio, image: p.photo, sameAs: p.linkedin ? [p.linkedin] : [] }));
---
<Base ld={ld} title="Leadership" description="The people responsible for NextGenergy's work.">
  <PageHero eyebrow="Company" title="Leadership" lede="The people responsible for NextGenergy's work." crumbs={[['/company/about', 'Company']]} />
  <section class="section">
    <div class="wrap">
      {people.map((p) => (
        <article class="person">
          <div class="photo"><img src={p.photo} alt={`Portrait of ${p.name}`} width="480" height="480" loading="eager" /></div>
          <div>
            <h2 style="margin-bottom:0.2rem">{p.name}</h2>
            <p class="eyebrow plain" style="margin:0 0 1rem">{p.role}</p>
            <p class="prose">{p.bio}</p>
            {p.linkedin && <p><a href={p.linkedin}>LinkedIn</a> · <a href={site.substack}>Every Watt Counts</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>}
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
<style>
  .person { display: grid; grid-template-columns: 1fr; gap: 2rem; max-width: 900px; }
  @media (min-width: 700px) { .person { grid-template-columns: 220px 1fr; } }
  .photo { width: 220px; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--paper-2); border: 1px solid var(--line); }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .person + .person { margin-top: 3rem; }
</style>
