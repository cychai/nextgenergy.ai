---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/data/site';
---
<Base title="Contact" description="Talk to the NextGenergy team about a new build, a retrofit, a heat-reuse project, or a turnover package you would like verified.">
  <PageHero eyebrow="Company" title="Talk to our team." lede="Tell us about your project, your cooling requirements and your timeline. We will come back with the right person." crumbs={[['/company/about', 'Company']]} />
  <section class="section">
    <div class="wrap">
      <div class="split">
        <div>
          <p><strong>Email</strong><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p><strong>Location</strong><br />{site.location}</p>
          <p><strong>Elsewhere</strong><br /><a href={site.linkedin}>LinkedIn</a> · <a href={site.substack}>Every Watt Counts on Substack</a></p>
          <div class="starts">
            <p class="eyebrow plain" style="margin:0 0 0.6rem">Where to start</p>
            <a class="start" href="?topic=product#form" data-topic="product"><strong>Discuss a cooling configuration</strong><span>Tell us the IT load, site, timeline and main constraints.</span></a>
            <a class="start" href="?topic=commissioning#form" data-topic="commissioning"><strong>Request a commissioning review</strong><span>Tell us what records exist, the state of the system and what can be tested.</span></a>
            <a class="start" href="?topic=heat#form" data-topic="heat"><strong>Assess heat-reuse potential</strong><span>Tell us the heat source, possible users, distance and temperatures.</span></a>
          </div>
          <p class="small muted" style="margin-top:1.2rem"><strong>Early-stage projects are welcome.</strong> If you do not yet have a system diagram or equipment list, tell us what you know and we will help define the next step.</p>
          <p class="small muted"><strong>What happens next.</strong> We reply within two working days with questions or a suggested next step. A formal scope and quotation follow once the basic requirements are clear.</p>
        </div>
        <form id="form" class="tool" data-contact data-to={site.email} novalidate>
          <div class="field"><label for="name">Name</label><input id="name" name="name" type="text" required maxlength="120" autocomplete="name" /></div>
          <div class="field"><label for="org">Organisation</label><input id="org" name="org" type="text" maxlength="160" autocomplete="organization" /></div>
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required maxlength="200" autocomplete="email" /></div>
          <div class="field"><label for="topic">What is this about?</label>
            <select id="topic" name="topic" required>
              <option value="" selected disabled>Choose a topic</option>
              <option>Product enquiry or quote</option><option>Field testing or operations</option><option>New build</option><option>Retrofit</option><option>Heat reuse</option><option>Commissioning or verification of an existing system</option><option>Partnership</option><option>Something else</option>
            </select></div>
          <div class="field"><label for="msg">Message</label><textarea id="msg" name="message" rows="6" required minlength="10" maxlength="5000"></textarea></div>
          <div class="hp" aria-hidden="true"><label for="website">Leave this empty</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <p class="form-status" data-status role="status" hidden></p>
          <div class="btn-row" style="margin-top:0.5rem;align-items:center"><button class="btn primary" type="submit" data-send>Send message</button><span class="small muted">or write to <a href={`mailto:${site.email}`}><span class="mono">{site.email}</span></a></span></div>
          <p class="small muted" style="margin:1rem 0 0">Your message is sent to our team over HTTPS and used only to reply to you; it is not added to any mailing list. If the form cannot send, it opens the same message in your email app instead. See our <a href="/company/privacy">privacy notice</a>.</p>
        </form>
      </div>
    </div>
  </section>
</Base>
<script>
  const f = document.querySelector('[data-contact]');
  const status = f?.querySelector('[data-status]');
  const btn = f?.querySelector('[data-send]');
  const opened = Date.now();
  const TOPIC = { product: 'Product enquiry or quote', commissioning: 'Commissioning or verification of an existing system', field: 'Field testing or operations', heat: 'Heat reuse' };
  const HINT = { product: 'IT load, site location, timeline and main constraints. A rough idea is fine.', commissioning: 'What system is installed, what records exist and what state it is in.', field: 'Site location, system size and the service you are looking for.', heat: 'Heat source and temperature, possible heat users, distance between them.' };
  const pre = new URLSearchParams(location.search).get('topic');
  if (pre && TOPIC[pre] && f) { f.topic.value = TOPIC[pre]; f.message.placeholder = HINT[pre]; }
  const say = (msg, kind) => { if (!status) return; status.textContent = msg; status.dataset.kind = kind; status.hidden = false; };
  const g = (d, k) => String(d.get(k) ?? '').trim();
  function mailtoFallback(d) {
    const subject = `[nextgenergy.ai] ${g(d, 'topic')} — ${g(d, 'name')}${g(d, 'org') ? ', ' + g(d, 'org') : ''}`;
    const body = `${g(d, 'message')}\n\n—\n${g(d, 'name')}${g(d, 'org') ? '\n' + g(d, 'org') : ''}\n${g(d, 'email')}`;
    location.href = `mailto:${f.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  }
  f?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!f.checkValidity()) { f.reportValidity(); say('Please complete the highlighted fields.', 'error'); return; }
    const d = new FormData(f);
    const payload = { name: g(d, 'name'), org: g(d, 'org'), email: g(d, 'email'), topic: g(d, 'topic'), message: g(d, 'message'), website: g(d, 'website'), elapsed: Date.now() - opened };
    btn.disabled = true; say('Sending…', 'info');
    try {
      const r = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const j = await r.json().catch(() => ({}));
      if (r.ok && j.ok) { f.reset(); say('Thank you. Your message has reached our team; we reply within two working days.', 'ok'); return; }
      if (j.error === 'validation') { say('Please check your name, email, topic and message, then send again.', 'error'); btn.disabled = false; return; }
      say('The form could not send just now, so we have opened the message in your email app. Your text is kept there.', 'info');
      mailtoFallback(d);
    } catch {
      say('The form could not send just now, so we have opened the message in your email app. Your text is kept there.', 'info');
      mailtoFallback(d);
    }
    btn.disabled = false;
  });
</script>
<style>
  .starts { margin-top: 1.6rem; }
  .start { display: block; padding: 0.8rem 1rem; margin-bottom: 0.6rem; border: 1px solid var(--line-2); border-radius: var(--r); background: var(--white); color: inherit; text-decoration: none; }
  .start:hover { border-color: var(--water); }
  .start strong { display: block; color: var(--ink); font-size: 0.98rem; }
  .start span { display: block; color: var(--ink-3); font-size: 0.88rem; margin-top: 0.15rem; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .form-status { margin: 0.8rem 0 0; padding: 0.7rem 0.9rem; border-left: 3px solid var(--blue); background: var(--water-2); font-size: 0.95rem; }
  .form-status[data-kind="ok"] { border-color: var(--green); background: #e7f6ea; }
  .form-status[data-kind="error"] { border-color: #b42318; background: #fef3f2; color: #7a271a; }
  .tool select:invalid { color: var(--ink-3); }
  .tool input[type="text"], .tool input[type="email"], .tool textarea { width: 100%; font: inherit; padding: 0.7rem 0.9rem; border: 1px solid var(--line); border-radius: var(--r); background: var(--paper); color: var(--ink); }
</style>
