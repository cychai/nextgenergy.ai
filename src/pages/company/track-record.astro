---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { claims } from '@/data/claims';
const mw = claims['deployed-1000mw'];
const NDA = 'Provided under a non-disclosure agreement';
// Six fixed fields per case. Only information already published is filled in; everything else says what it would take to see it.
const cases = [
  { year: '2021', place: 'Asia', type: 'Immersion cooling · residential heating', scale: '25 MW',
    cond: '25 MW liquid-cooled IT capacity, Asia, 2021. Location and client not named.',
    scope: 'Liquid cooling with waste-heat recovery, delivered by the founding team through their earlier company. The split between equipment supply, design, integration and operation: ' + NDA.toLowerCase() + '.',
    arch: 'Immersion liquid cooling; recovered heat supplies space heating to a residential community.',
    duty: 'Supply and return temperatures, heat delivered: ' + NDA.toLowerCase() + '.',
    period: 'In the project year 2021; the operating record and its dates: ' + NDA.toLowerCase() + '.',
    evidence: NDA + '.' },
  { year: '2023', place: 'Asia', type: 'Direct-to-chip cooling · aquaculture', scale: '12 MW',
    cond: '12 MW liquid-cooled IT capacity, Asia, 2023. Location and client not named.',
    scope: 'Cold-plate liquid cooling with heat recovery, delivered by the founding team through their earlier company. Division of design, integration and operation: ' + NDA.toLowerCase() + '.',
    arch: 'Cold-plate liquid cooling; recovered heat is supplied to industrial aquaculture ponds.',
    duty: 'Control objective: a constant pond temperature through the year. This is the design target, not a published measurement; the measured range and allowed variation: ' + NDA.toLowerCase() + '.',
    period: 'In the project year 2023; the operating record and its dates: ' + NDA.toLowerCase() + '.',
    evidence: NDA + '.' },
  { year: '2024', place: 'Asia, above 3,000 m altitude', type: 'Heat reuse · space heating', scale: 'Not published',
    cond: 'Above 3,000 m altitude, Asia, 2024. Capacity not published; location and client not named.',
    scope: 'Heat-reuse system with a redesigned CDU, delivered by the founding team through their earlier company. Other scope: ' + NDA.toLowerCase() + '.',
    arch: 'Waste heat used for space heating. When the heating side needed a higher supply temperature in cold weather, the CDU was redesigned with a tighter approach temperature, so the loop could deliver warmer water without running the chips hotter.',
    duty: 'The approach temperature before and after the redesign, and the supply temperature reached: ' + NDA.toLowerCase() + '.',
    period: 'In the project year 2024; the operating record and its dates: ' + NDA.toLowerCase() + '.',
    evidence: NDA + '.' },
  { year: '2025', place: 'Asia', type: 'Heat recovery · commercial heating', scale: '20 MW',
    cond: '20 MW, Asia, 2025. Location and client not named.',
    scope: 'Heat-recovery system, delivered by the founding team through their earlier company. Division of design, integration and operation: ' + NDA.toLowerCase() + '.',
    arch: 'A heat-recovery system supplying heating to commercial buildings.',
    duty: 'Supply and return temperatures, heat delivered: ' + NDA.toLowerCase() + '.',
    period: 'In the project year 2025; the operating record and its dates: ' + NDA.toLowerCase() + '.',
    evidence: NDA + '.' },
];
const FIELDS = [['cond', 'Project conditions'], ['scope', 'Scope of delivery'], ['arch', 'System architecture'], ['duty', 'Key operating conditions'], ['period', 'Operating observation period'], ['evidence', 'Evidence available']];

---
<Base title="Track record" description="Projects delivered by the NextGenergy founding team before NextGenergy: immersion and direct-to-chip liquid cooling with waste heat reused for residential, commercial and aquaculture heating.">
  <PageHero eyebrow="Company" title="Track record" lede="The projects behind our figures. All were delivered by our founding team through the company they built before NextGenergy; none is presented as a NextGenergy installed base." crumbs={[['/company/about', 'Company']]} />
  <section class="section">
    <div class="wrap">
      <div class="figs">
        <div><span class="v">{mw.value}</span><span class="l">{mw.statement}</span><span class="c"><b>Condition:</b> {mw.condition}</span></div>
      </div>
      <h2 style="margin-top:2.5rem">Representative projects</h2>
      <p class="muted" style="max-width:62ch">Each project is described in the same six fields. Locations and clients are not named. Scale is liquid-cooled IT capacity where it is published; it measures equipment delivered, not the heat supplied to users. Heating results are reported only as the project's control objective unless a measurement is published.</p>
      <div class="cases">
        {cases.map((c) => (
          <article class="case">
            <div class="meta"><span class="yr">{c.year}</span><span>{c.place}</span><span>{c.scale}</span></div>
            <h3>{c.type}</h3>
            <dl>{FIELDS.map(([k, l]) => <><dt>{l}</dt><dd>{c[k]}</dd></>)}</dl>
          </article>
        ))}
      </div>
      <p class="small muted" style="margin-top:2rem">NextGenergy Technology Inc. was incorporated in 2025. Projects delivered by NextGenergy will be added here as they are handed over. To see the evidence behind any of these four projects, <a href="/company/contact?topic=product#form">ask us</a> and we will set up the non-disclosure agreement. Read more about the team on <a href="/company/leadership">Leadership</a>, and about heat reuse in <a href="/insights/waste-heat-becomes-an-asset">Waste Heat Becomes an Asset</a>.</p>
    </div>
  </section>
</Base>
<style>
  .figs .v { display: block; font-family: var(--serif); font-size: 2rem; font-weight: 600; line-height: 1.1; }
  .figs .l { display: block; color: var(--ink-2); margin-top: 0.3rem; }
  .figs .c { display: block; font-size: 0.82rem; color: var(--ink-3); margin-top: 0.4rem; max-width: 70ch; }
  .cases { display: grid; gap: 1.5rem; grid-template-columns: 1fr; margin-top: 1.5rem; }
  @media (min-width: 800px) { .cases { grid-template-columns: 1fr 1fr; } }
  .case { background: var(--white); border: 1px solid var(--line-2); border-radius: var(--r); padding: 1.8rem; display: flex; flex-direction: column; }
  .case .meta { display: flex; gap: 0.8rem; align-items: baseline; font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
  .case .yr { color: var(--heat); font-weight: 600; font-size: 0.9rem; }
  .case h3 { margin: 0.5rem 0 0.5rem; font-size: 1.2rem; }
  .case p { color: var(--ink-2); margin: 0 0 1rem; }
  .case dl { margin: 0.4rem 0 0; display: grid; grid-template-columns: 1fr; gap: 0.15rem; font-size: 0.92rem; border-top: 1px solid var(--line-2); padding-top: 0.8rem; }
  .case dd + dt { margin-top: 0.6rem; }
  .case dt { color: var(--ink-3); font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .case dd { margin: 0; color: var(--ink); }
</style>
