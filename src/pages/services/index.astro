---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Card from '@/components/Card.astro';
import { services } from '@/data/sections';
---
<Base title="Services" description="NextGenergy services: thermal design and selection, integration and factory pre-assembly, commissioning and verification, operations and long-term support.">
  <PageHero eyebrow="Services" title="Four services, one team, one set of records" lede="Each service can be engaged on its own. Commissioning is often the first engagement, for a system somebody else built." />
  <section class="section">
    <div class="wrap">
      <div class="grid c2">
        {services.map((s, i) => <Card href={`/services/${s.slug}`} num={String(i + 1).padStart(2, '0')} title={s.title}>{s.summary}</Card>)}
      </div>
    </div>
  </section>
</Base>
