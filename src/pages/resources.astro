---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('insights', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const groups = [
  { href: '/approach', title: 'Approach', lede: 'How we decide what to build, what to test and what to write down.', links: [
    ['/approach/thermal-path', 'The whole thermal path, in six boundaries'],
    ['/approach/return-water', 'Return-water grade and who can buy the heat'],
    ['/approach/three-clocks', 'The three clocks of leak risk'],
  ] },
  { href: '/evidence', title: 'Evidence', lede: 'What we hand over, and the criteria it is tested against.', links: [
    ['/evidence/commissioning', 'Commissioning and acceptance criteria'],
    ['/evidence/turnover', 'The turnover package'],
    ['/evidence/samples', 'Sample records (templates)'],
    ['/evidence/leak-points', 'Ten leak points'],
    ['/evidence/standards', 'Standards work'],
    ['/evidence/canada-principles', "The numbers Canada's principles ask for"],
  ] },
  { href: '/tools', title: 'Tools', lede: 'Check your own numbers before you bring them to us or anyone else.', links: [
    ['https://sim.nextgenergy.ai/', 'Liquid cooling simulator'],
    ['https://sim.nextgenergy.ai/catalog/', 'CDU and equipment catalog'],
    ['/tools/return-water', 'Return-water grade → heat buyers'],
    ['/tools/approach-temp', 'CDU approach and free-cooling estimator'],
    ['/tools/leak-checklist', 'Turnover self-check'],
  ] },
  { href: '/insights', title: 'Insights', lede: 'Every Watt Counts: long-form writing on power, liquid cooling and heat reuse.', links: posts.map((p) => [`/insights/${p.id}`, p.data.title]) },
];
---
<Base title="Resources" description="NextGenergy resources: our approach to liquid cooling, the evidence we hand over, engineering tools and long-form articles.">
  <PageHero eyebrow="Resources" title="Approach, evidence, tools and insights." lede="The thinking and the records behind our products and field services, and the tools we use ourselves." />
  <section class="section">
    <div class="wrap">
      <div class="hub">
        {groups.map((g) => (
          <div class="hub-card">
            <h2><a href={g.href}>{g.title}</a></h2>
            <p class="muted">{g.lede}</p>
            <ul>{g.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
            <a class="more" href={g.href}>All {g.title.toLowerCase()} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .hub { display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 800px) { .hub { grid-template-columns: 1fr 1fr; } }
  .hub-card { background: var(--white); border: 1px solid var(--line-2); border-radius: var(--r); padding: 2rem; display: flex; flex-direction: column; }
  .hub-card h2 { font-size: 1.5rem; margin: 0 0 0.4rem; }
  .hub-card h2 a { color: var(--ink); text-decoration: none; }
  .hub-card p { margin: 0 0 1rem; }
  .hub-card ul { list-style: none; padding: 0; margin: 0 0 1rem; }
  .hub-card li { border-top: 1px solid var(--line-2); }
  .hub-card li a { display: block; padding: 0.65rem 0; text-decoration: none; color: var(--ink); }
  .hub-card li a:hover { color: var(--water); }
  .hub-card .more { margin-top: auto; font-size: 0.9rem; font-weight: 600; color: var(--water); text-decoration: none; }
</style>
