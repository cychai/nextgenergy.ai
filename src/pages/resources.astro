---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { getCollection } from 'astro:content';
import { news } from '@/data/news';
const posts = (await getCollection('insights', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const groups = [
  { href: '/approach', title: 'Approach', lede: 'How we decide what to build, what to test and what to write down.', links: [
    ['/approach/thermal-path', 'The whole thermal path, in six boundaries'],
    ['/approach/return-water', 'Return-water grade and who can buy the heat'],
    ['/approach/three-clocks', 'The three clocks of leak risk'],
  ] },
  { href: '/evidence', title: 'Evidence', lede: 'What we hand over, and the criteria it is tested against.', links: [
    ['/evidence/commissioning', 'Commissioning and acceptance criteria'],
    ['/resources/commissioning-white-paper', 'White paper: Liquid Cooling Commissioning and Site Acceptance'],
    ['/evidence/turnover', 'The turnover package'],
    ['/evidence/samples', 'Sample records (templates)'],
    ['/evidence/leak-points', 'Ten leak points'],
    ['/evidence/standards', 'Standards we follow'],
    ['/evidence/canada-principles', "The numbers Canada's principles ask for"],
  ] },
  { href: '/tools', title: 'Tools', lede: 'Check your own numbers before you bring them to us or anyone else.', links: [
    ['https://sim.nextgenergy.ai/', 'Liquid cooling simulator'],
    ['https://sim.nextgenergy.ai/catalog/', 'CDU and equipment catalog'],
    ['/tools/return-water', 'Return-water grade → heat buyers'],
    ['/tools/approach-temp', 'CDU approach and free-cooling estimator'],
    ['/tools/leak-checklist', 'Turnover self-check'],
  ] },
  { href: '/insights', title: 'Insights', lede: 'Every Watt Counts: long-form writing on power, liquid cooling and heat reuse.', links: posts.map((p) => [`/insights/${p.id}`, p.data.title]) },
  { href: '/company/news', title: 'News', lede: 'Company announcements: events, new tools and training, published guidance.', links: news.slice(0, 3).map((n) => [`/company/news/${n.slug}`, n.title]) },
];
---
<Base title="Resources" description="NextGenergy resources: our approach to liquid cooling, the evidence we hand over, engineering tools and long-form articles.">
  <PageHero eyebrow="Resources" title="Approach, evidence, tools and insights." lede="The thinking and the records behind our products and field services, the tools we use ourselves, and company news." />
  <section class="section">
    <div class="wrap">
      <a class="card wp-feature" href="/resources/commissioning-white-paper">
        <span class="eyebrow plain">White paper</span>
        <strong>Liquid Cooling Commissioning and Site Acceptance</strong>
        <span class="muted">Interface verification and release for single-phase cold-plate systems. Six boundaries, four release gates and the evidence each release requires. Free download.</span>
      </a>
      <div class="hub">
        {groups.map((g) => (
          <div class="card hub-card">
            <h2><a href={g.href}>{g.title}</a></h2>
            <p class="muted">{g.lede}</p>
            <ul>{g.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
            <a class="more" href={g.href}>All {g.title.toLowerCase()} →</a>
            {g.href === '/company/news' && news.slice(0, 3).some((n) => n.legalAttribution) && <p class="small muted" style="margin-top:1rem">{news.slice(0, 3).find((n) => n.legalAttribution)?.legalAttribution}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .wp-feature { display: grid; gap: 0.3rem; margin-bottom: 1.5rem; text-decoration: none; border-left: 3px solid var(--water); }
  .wp-feature .eyebrow { margin: 0; }
  .wp-feature strong { color: var(--ink); font-size: var(--fs-md); }
  .wp-feature:hover strong { color: var(--water); }
  .hub { display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 800px) { .hub { grid-template-columns: 1fr 1fr; } }
  .hub-card { gap: 0; }
  .hub-card h2 { font-size: var(--fs-md); margin: 0; }
  .hub-card h2 a { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--ink); text-decoration: none; }
  .hub-card p { margin: 0 0 1rem; color: inherit; }
  .hub-card ul { list-style: none; padding: 0; margin: 0 0 1rem; }
  .hub-card li { border-top: 1px solid var(--line-2); }
  .hub-card li a { display: flex; align-items: center; min-height: var(--tap); padding: 0.4rem 0; text-decoration: none; color: var(--ink); }
  .hub-card li a:hover { color: var(--water); }
  .hub-card .more { display: inline-flex; align-items: center; min-height: var(--tap); padding-top: 0; text-decoration: none; }
</style>
