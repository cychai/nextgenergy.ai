---
import { site, footerNav } from '@/data/site';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="cols">
      <div>
        <a href="/" class="brand"><img src="/brand/logo-v3.png" alt="NextGenergy — Make every watt count" width="1400" height="459" /></a>
        <p style="margin-top:1rem; max-width: 34ch;">Prefabricated liquid cooling for AI data centres: we plan and design the system, deliver skids, CDUs, ORv3 racks and cooling plant, and test, commission and maintain the liquid loop in the field. Every boundary comes with its evidence.</p>
        <p class="small">{site.location}<br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="small"><a href={site.linkedin}>LinkedIn</a> · <a href={site.substack}>Every Watt Counts</a> · <a href="/insights/rss.xml">RSS</a></p>
      </div>
      {footerNav.map((c) => (
        <div>
          <h4>{c.title}</h4>
          <ul>{c.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="entity">
      <p><strong>Who operates this site.</strong> NextGenergy is operated in North America by NextGenergy Technology Inc. and NextGenergy USA, LLC. The contracting entity for your region in North America is named on your quotation. Regulated field work is carried out by licensed partners or by licensed engineers engaged by the owner.</p>
      <p><strong>Related sites.</strong> <a href="https://sim.nextgenergy.ai">Liquid Cooling Simulator</a> (sim.nextgenergy.ai), a design-exploration tool by NextGenergy · <a href="https://lca.nextgenergy.ai">Liquid Cooling Academy</a> (lca.nextgenergy.ai), training operated by NextGenergy USA, LLC.</p>
    </div>
    <div class="legal">
      <span>© {year} NextGenergy Technology Inc. and NextGenergy USA, LLC. All rights reserved.</span>
      <span><a href="/company/privacy">Privacy</a> · <a href="/company/contact">Contact</a> · <a href="/insights/rss.xml">RSS</a></span>
    </div>
  </div>
</footer>
