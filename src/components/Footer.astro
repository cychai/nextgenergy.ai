---
import { site, footerNav } from '@/data/site';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="cols">
      <div>
        <a href="/" class="brand"><img src="/brand/logo-v3-360.png" alt="NextGenergy — Make every watt count" width="360" height="118" loading="lazy" decoding="async" /></a>
        <p class="about">Prefabricated liquid cooling for AI data centres: we plan and design the system, deliver skids, CDUs, ORv3 racks and cooling plant, and test, commission and maintain the liquid loop in the field. Every boundary comes with its evidence.</p>
        <p class="small contact-links">{site.location}<br /><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={site.phone.tel} class="ftr-tel">{site.phone.display}</a> <span class="muted">· AI receptionist, 24/7</span></p>
        <p class="small contact-links"><a href={site.linkedin}>LinkedIn</a> · <a href={site.substack}>Every Watt Counts</a> · <a href="/insights/rss.xml">RSS</a></p>
      </div>
      {footerNav.map((c) => (
        <div>
          <h2 class="ftr-h">{c.title}</h2>
          <ul>{c.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="entity">
      <p><strong>Who operates this site.</strong> NextGenergy · North America. The contracting entity for your region is named on each quotation. Regulated field work is carried out by licensed partners or by licensed engineers engaged by the owner.</p>
      <p><strong>Related sites.</strong> <a href="https://sim.nextgenergy.ai">Liquid Cooling Simulator</a> (sim.nextgenergy.ai), a design-exploration tool by NextGenergy · <a href="https://lca.nextgenergy.ai">Liquid Cooling Academy</a> (lca.nextgenergy.ai), training operated by NextGenergy.</p>
    </div>
    <div class="legal">
      <span>© {year} NextGenergy. All rights reserved.</span>
      <span><a href="/company/privacy">Privacy</a> · <a href="/company/contact">Contact</a> · <a href="/insights/rss.xml">RSS</a></span>
    </div>
  </div>
</footer>
