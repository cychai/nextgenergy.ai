---
/**
 * Click-to-load YouTube embed. Nothing is requested from YouTube until the visitor presses play;
 * then the privacy-enhanced youtube-nocookie.com player is loaded. The poster is served from this site.
 */
interface Props { id: string; title: string; poster?: string; }
const { id, title, poster = `/video/${id}.jpg` } = Astro.props;
---
<div class="yt" data-yt={id}>
  <img src={poster} alt="" width="1280" height="720" loading="lazy" />
  <button type="button" class="play" aria-label={`Play video: ${title}`}><span class="tri" aria-hidden="true"></span></button>
  <span class="cap">{title}</span>
  <noscript><a class="cap" href={`https://www.youtube-nocookie.com/embed/${id}`}>Watch on YouTube</a></noscript>
  <p class="consent">Pressing play loads the video from YouTube (youtube-nocookie.com). Until then, nothing is sent to Google.</p>
</div>
<style>
  .yt { position: relative; aspect-ratio: 16/9; background: #000; border-radius: var(--r); overflow: hidden; margin: 1.5rem 0; }
  .yt img, .yt iframe { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .play { position: absolute; inset: 0; margin: auto; width: 5rem; height: 5rem; border-radius: 50%; border: 0; background: var(--blue); cursor: pointer; display: grid; place-items: center; box-shadow: 0 6px 24px rgba(0,0,0,0.35); }
  .play:hover { background: #17408a; }
  .tri { width: 0; height: 0; border-left: 1.6rem solid #fff; border-top: 1rem solid transparent; border-bottom: 1rem solid transparent; margin-left: 0.35rem; }
  .cap { position: absolute; left: 1rem; top: 0.9rem; color: #fff; font-weight: 600; text-shadow: 0 1px 6px rgba(0,0,0,0.6); font-size: 0.95rem; }
  .consent { position: absolute; left: 1rem; right: 1rem; bottom: 0.6rem; margin: 0; color: #d7dfec; font-size: 0.75rem; text-shadow: 0 1px 6px rgba(0,0,0,0.6); }
</style>
<script>
  document.querySelectorAll('[data-yt]').forEach((box) => {
    box.querySelector('.play')?.addEventListener('click', () => {
      const id = box.getAttribute('data-yt');
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      f.title = box.querySelector('.play')?.getAttribute('aria-label') ?? 'Video';
      f.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      f.setAttribute('allowfullscreen', '');
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      f.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;display:block';
      box.replaceChildren(f);
    });
  });
</script>
