---
/**
 * Full-width trade-show strip above the site header. Base.astro renders it only when a page passes
 * `eventBar` (the home page). Removed from the HTML on builds after event.hideFrom; until then
 * /event-expiry.js removes it in the browser once the date has passed.
 */
import { event, showEvent } from '@/data/site';
const on = showEvent();
---
{on && (
  <div class="event-strip" data-hide-from={event.hideFrom.toISOString()} role="region" aria-label="Upcoming event">
    <div class="wrap">
      <p>
        <span class="full">Meet us at <strong>Booth {event.booth}</strong> · {event.fullName} · 20–21 October · International Centre, Mississauga</span>
        <span class="short"><strong>Booth {event.booth}</strong> · GDCC Canada · Oct 20–21</span>
      </p>
      <a class="event-cta" href={`/company/contact?topic=${event.topic}#form`}>Book a time <span aria-hidden="true">→</span></a>
    </div>
    <script is:inline src="/event-expiry.js" defer></script>
  </div>
)}
<style>
  .event-strip { background: var(--ink); color: var(--on-ink); font-size: var(--fs-sm); line-height: 1.35; }
  .event-strip .wrap { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; padding-block: 0.25rem; min-width: 0; }
  .event-strip p { margin: 0; min-width: 0; flex: 1 1 auto; overflow-wrap: break-word; }
  .event-strip strong { color: var(--on-ink); font-weight: 700; }
  .event-strip .short { display: none; }
  /* The link box is 44 px tall for touch; the visible pill is drawn by ::before at its original height. */
  .event-cta { position: relative; z-index: 0; flex: 0 0 auto; display: inline-flex; align-items: center; min-height: var(--tap); color: var(--on-ink); font-weight: 600; white-space: nowrap; padding: 0 0.8rem; text-decoration: none; }
  .event-cta::before { content: ""; position: absolute; z-index: -1; left: 0; right: 0; top: 50%; height: 2rem; transform: translateY(-50%); border: 1px solid var(--on-ink-line); border-radius: var(--r-pill); }
  .event-cta:hover, .event-cta:focus-visible { color: var(--ink); }
  .event-cta:hover::before, .event-cta:focus-visible::before { background: var(--on-ink); }
  @media (max-width: 700px) {
    .event-strip .full { display: none; }
    .event-strip .short { display: inline; }
  }
</style>
