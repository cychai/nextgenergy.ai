---
import Icon from '@/components/Icon.astro';
import { nav, site } from '@/data/site';
import { menu } from '@/data/menu';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const under = (p: string) => path === p || path.startsWith(p + '/');
const isCurrent = (n: { href: string; match?: string[] }) => (n.match ?? [n.href]).some(under);
const here = (href: string) => (href === path ? 'page' : undefined);
const sub = (label: string) => `${label} submenu`;
---
<header class="hdr">
  <div class="wrap">
    <a href="/" class="brand" aria-label={`${site.name} home`}><img src="/brand/logo-v3-360.png" alt="NextGenergy — Make every watt count" width="360" height="118" /></a>
    <nav class="nav" aria-label="Primary">
      {nav.map((n, i) => menu[n.href] ? (
        <div class="nav-item" data-dd>
          <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>
          <button type="button" class="dd-btn" aria-expanded="false" aria-controls={`dd-${i}`} aria-label={sub(n.label)}><Icon name="caret" /></button>
          <div class:list={['dd', menu[n.href].length > 1 && 'mega']} id={`dd-${i}`}>
            {menu[n.href].map((g) => (
              <div class="dd-g">
                {g.title && <a class="dd-h" href={g.href} aria-current={here(g.href!)}>{g.title}</a>}
                {g.lede && <p class="dd-p">{g.lede}</p>}
                {g.links.map(([href, label]) => <a href={href} aria-current={here(href)}>{label}</a>)}
              </div>
            ))}
          </div>
        </div>
      ) : (
        <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="hdr-end">
      <button type="button" class="srch-btn" data-search aria-haspopup="dialog" aria-controls="srch" aria-label="Search" title="Search"><Icon name="search" /></button>
      <a href="/company/contact" class="btn hdr-cta">Talk to our team</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mnav" data-menu data-label-open="Close" data-label-closed="Menu"><span class="menu-ico" aria-hidden="true"><i></i><i></i><i></i></span><span data-menu-label>Menu</span></button>
    </div>
  </div>
  <div class="mnav" id="mnav">
    <div class="wrap">
      <button type="button" class="msrch" data-search aria-haspopup="dialog" aria-controls="srch"><Icon name="search" />Search</button>
      {nav.map((n) => menu[n.href] ? (
        <div class="mrow">
          <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>
          <details name="mnav" open={isCurrent(n)}>
            <summary aria-label={sub(n.label)}><Icon name="chevron-down" /></summary>
            <div class="msub">
              {menu[n.href].map((g) => (
                <>
                  {g.title && <a class="msub-h" href={g.href} aria-current={here(g.href!)}>{g.title}</a>}
                  {g.links.map(([href, label]) => <a href={href} aria-current={here(href)}>{label}</a>)}
                </>
              ))}
            </div>
          </details>
        </div>
      ) : (
        <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>
      ))}
      <a href="/company/contact" aria-current={under('/company/contact') ? 'page' : undefined}>Contact</a>
    </div>
  </div>
  <div class="mnav-scrim" data-menu-scrim hidden></div>
</header>
<noscript><style is:inline>[data-search] { display: none !important; }</style></noscript>
<dialog class="srch" id="srch" aria-label="Search this site" data-hint="Type a word or two. Up and down arrows choose a result, Enter opens it, Esc closes." data-none="No results for “{q}”." data-count="{n} results" data-error="Search is unavailable right now. Please use the menu or the footer links.">
  <div class="srch-top">
    <Icon name="search" />
    <input type="text" inputmode="search" role="combobox" aria-label="Search this site" placeholder="Search this site" aria-expanded="false" aria-controls="srch-list" aria-autocomplete="list" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" />
    <button type="button" class="srch-x" data-search-close>Close</button>
  </div>
  <div class="srch-list" id="srch-list" role="listbox" aria-label="Search results"></div>
  <p class="srch-msg" role="status">Type a word or two. Up and down arrows choose a result, Enter opens it, Esc closes.</p>
</dialog>
<script>
  import '@/scripts/site';
</script>
